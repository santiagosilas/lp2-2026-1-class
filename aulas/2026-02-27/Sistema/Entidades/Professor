namespace Sistema.Entidades;
public class Professor:Pessoa
{
    public int Id {get; set;}
    public string Nome {get; set;}
    public string Apelido {get; set;} = string.Empty;
    public Professor(int id, string nome, string cpf)
    {
        this.Nome = nome;
        this.Id = id;
        base(cpf);
    }

}